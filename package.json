{
  "name": "ai-crypto-dashboard",
  "version": "1.0.0",
  "description": "A comprehensive crypto portfolio tracker dashboard built with React",
  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "build:css:prod": "npx tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "prestart": "npx tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "prebuild": "npm run build:css:prod",
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development --open"
  },
  "keywords": [
    "crypto",
    "portfolio",
    "tracker",
    "react",
    "dashboard"
  ],
  "author": "Eric Chiaus",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.0",
    "postcss-loader": "^8.2.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "postcss": "^8.5.8",
    "style-loader": "^3.3.0",
    "tailwindcss": "^3.4.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
